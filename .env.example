# ============================================================
# ProdTrack — variáveis de ambiente (valores de demonstração)
# Copie este arquivo para `.env` antes de `docker compose up`.
# Credenciais estáticas apenas para desenvolvimento/demo local.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=prodtrack
POSTGRES_PASSWORD=prodtrack
POSTGRES_DB=prodtrack
# Dentro do Docker o host do banco é "db". Fora dele (dev local), use "localhost".
DATABASE_URL=postgresql://prodtrack:prodtrack@db:5432/prodtrack?schema=public

# --- API (backend) ---
PORT=3333
JWT_SECRET=prodtrack-dev-secret
JWT_EXPIRES_IN=24h

# --- Mock IoT (worker de polling) ---
MOCK_PORT=3001
# Dentro do Docker o mock é "mock-iot". Para consumir o mock hospedado na VPS, troque por:
# MOCK_URL=https://prs.adolfo.tec.br/mock
MOCK_URL=http://mock-iot:3001/mock
POLL_INTERVAL_MS=7000
MOCK_TIMEOUT_MS=3000

# --- Credenciais sintéticas do seed (perfis Gestor e Operador) ---
GESTOR_EMAIL=gestor@prs.com.br
GESTOR_PASSWORD=Gestor@123
OPERADOR_EMAIL=operador@prs.com.br
OPERADOR_PASSWORD=Operador@123
